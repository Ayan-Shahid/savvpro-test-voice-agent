# Non-secret settings read by docker compose. Copy to .env and adjust. Secrets live in secrets/ (SOPS).
PUBLIC_ORIGIN=http://localhost:8080
# Google sign-in (client secret goes in secrets/runtime/google_client_secret, never here)
# GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# staging/production:
# PUBLIC_ORIGIN=https://astro.ayandev.app
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_STARTTLS=true
# MAIL_FROM=AstroVoice <bookings@ayandev.app>
# MAIL_FROM_ADDRESS=bookings@ayandev.app
# REGISTRY=astrovoice
# TAG=local
